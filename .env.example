# Copy to .env.local. Matches the credentials in docker-compose.yml.
DATABASE_URL=postgres://focusorbit:focusorbit@localhost:5433/focusorbit

# Better Auth. Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://localhost:3000
